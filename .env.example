# --- ballchasing ---
BALLCHASING_TOKEN=
BALLCHASING_BASE_URL=https://ballchasing.com/api
PLAYER_1_ID=steam:00000000000000000
PLAYER_2_ID=epic:00000000000000000000000000000000
PLAYER_3_ID=ps4:ExampleGamertag
PLAYER_1_ALIAS=Player One
PLAYER_2_ALIAS=Player Two
PLAYER_3_ALIAS=Player Three
MAX_REPLAY_AGE_HOURS=48
ALLOWED_PLAYLISTS=ranked-standard,unranked-standard,private,tournament
MAX_CANDIDATES_TO_INSPECT=10
BALLCHASING_MIN_INTERVAL_SECONDS=0.6
REQUEST_TIMEOUT_SECONDS=30

# --- AI ---
AI_PROVIDER=ollama
AI_TEMPERATURE=0.8
AI_MAX_OUTPUT_TOKENS=160
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-3-5-haiku-latest
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.0-flash

# --- tweet ---
TWEET_LANGUAGE=en
TWEET_HASHTAG=#RocketLeague
TWEET_MAX_WEIGHTED_LEN=280
TWEET_TARGET_MAX_CHARS=240
TWEET_ALLOW_EMOJI=true

# --- posting ---
POST_TO_X=false
X_AUTH_MODE=oauth1
X_API_BASE_URL=https://api.x.com
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_OAUTH2_USER_TOKEN=
COOLDOWN_HOURS=20
MANUAL_OUTPUT_DIR=out
CLIPBOARD_ENABLED=true

# --- storage / logging ---
DATABASE_PATH=data/rl_analyzer.sqlite3
LOG_DIR=logs
LOG_LEVEL=INFO
